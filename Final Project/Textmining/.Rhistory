files <- list.files(pattern = ".pdf$")
files <- list.files(pattern = ".pdf$")
#setting the WD so we can grab the pdf-files from the correct folder.
setwd("data/")
files <- list.files(pattern = ".pdf$")
head(files)
view(files)
keywords <-
c(
"konge",
"brev",
"befal",
"beskat",
"bisp",
"sogn",
"retterting",
"herreddag",
"ting",
"len",
"københavn",
"kbhvn",
"kansler",
"hof",
"rentemest",
"rigsraad",
"indkomst",
"foged",
"told",
"konsumption",
"accise",
"cise",
"landsting",
"stænderforsamling",
"landkommissær",
"landgilde",
"godsdrift",
"herlighed"
)
filelength <- length(files)
wordlength <- length(keywords)
word_count <- seq(1,filelength*wordlength)
dim(word_count) <- c(filelength,wordlength)
for (j in 1:length(files)) {
P1 <- pdftools::pdf_text(pdf = files[j]) %>%
str_to_lower() %>%
str_replace_all("\\t", "") %>%
str_replace_all("\n", " ") %>%
str_replace_all("      ", " ") %>%
str_replace_all("    ", " ") %>%
str_replace_all("   ", " ") %>%
str_replace_all("  ", " ") %>%
str_replace_all("[:digit:]", "") %>%
str_replace_all("[:punct:]", "") %>%
str_trim()
for (i in 1:length(keywords)) {
word_count[j,i] <- P1 %>% str_count(keywords[i]) %>% sum()
}
}
P1 <- pdftools::pdf_text(pdf = files[j]) %>%
str_to_lower() %>%
str_replace_all("\\t", "") %>%
str_replace_all("\n", " ") %>%
str_replace_all("      ", " ") %>%
str_replace_all("    ", " ") %>%
str_replace_all("   ", " ") %>%
str_replace_all("  ", " ") %>%
str_replace_all("[:digit:]", "") %>%
str_replace_all("[:punct:]", "") %>%
str_trim()
library(dplyr)
library(stringr)
library(pdftools)
library(ggplot2)
library(tidyr)
